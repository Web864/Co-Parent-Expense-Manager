{
  "name": "coparent-expense-manager-appdeploy-ui-postgresql",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.cjs",
    "preview": "vite preview",
    "doctor": "node scripts/doctor.cjs",
    "test": "node --test tests/*.test.cjs",
    "backup": "node scripts/backup.cjs",
    "test:integration": "node --test tests/integration.cjs",
    "test:browser": "node tests/browser.cjs",
    "db:migrate": "node scripts/migrate.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:accounts": "node --test tests/accounts.cjs",
    "account:complete-deletion": "node scripts/complete-deletion.cjs",
    "backup:validate": "node scripts/validate-restore.cjs",
    "benchmark:auth": "node scripts/benchmark-auth.cjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
