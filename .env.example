# Local PostgreSQL (create role + database before starting; never commit real passwords)
DATABASE_URL=postgresql://coparent_user:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:5432/coparent_db
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PGPOOL_MAX=10

# Production: set NODE_ENV=production, PUBLIC_ORIGIN=https://your-domain.example,
# COOKIE_SECURE=true, MIGRATE_ON_START=false. Apply schema with a migration role.
NODE_ENV=development
# Local default is true; production default is false.
# MIGRATE_ON_START=false
# Managed PostgreSQL: append ?sslmode=verify-full and configure trusted CA.
# PGSSLROOTCERT=C:/secure/provider-ca.pem
# Never use rejectUnauthorized=false or sslmode=no-verify in production.
# Optional isolated QA database, MUST differ from DATABASE_URL and end in _qa or _test:
# TEST_DATABASE_URL=postgresql://coparent_user:REPLACE@127.0.0.1:5432/coparent_qa
# Phase 2 email and account settings
EMAIL_PROVIDER=development
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=
# Explicit opt-in only. Writes secret-bearing test emails under ignored artifacts/mail-sink.
# Keep false except on a private local development machine; forbidden in production.
DEV_MAIL_SINK=false
AUTH_RATE_LIMIT_MAX=18
TOKEN_RATE_LIMIT_MAX=20
EMAIL_RATE_LIMIT_MAX=3
# Set your real official support route before launch (HTTPS URL or mailto address).
# SUPPORT_URL=https://your-domain.example/support
# PostgreSQL client tools for backup and disposable restore validation:
# PG_BIN=C:/Program Files/PostgreSQL/18/bin

# Production email requires EMAIL_PROVIDER=resend, a verified EMAIL_FROM domain,
# RESEND_API_KEY from your secret manager and DEV_MAIL_SINK=false.
